# VMT Backend Environment Configuration Example
# Copy to .env and set secure values for deployment

ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production
PASSWORD_PEPPER=dev-password-pepper-change-in-production
ADMIN_BOOTSTRAP_SECRET=dev-admin-bootstrap-secret
DATABASE_URL=sqlite+aiosqlite:///./vmt_ecosystem.db
LOCAL_STORAGE_PATH=./package_storage
QUARANTINE_PATH=./quarantine
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
